// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  AUTHOR
}

enum Status {
  ACTIVE
  INACTIVE
  FREEZE
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique @db.VarChar(52)
  posts    Post[]
  products Product[]
}

model Type {
  id       String    @id @default(cuid())
  name     String    @unique @db.VarChar(52)
  posts    Post[]
  products Product[]
}

model Post {
  id         String      @id @default(uuid())
  title      String      @db.VarChar(255)
  content    String
  body       String
  images     PostImage[]
  authorId   String
  categoryId String
  typeId     String
  author     User        @relation(fields: [authorId], references: [id])
  category   Category    @relation(fields: [categoryId], references: [id])
  type       Type        @relation(fields: [typeId], references: [id])
  tags       PostTag[] // Implicit Many-to-Many
  viewCount  Int         @default(0) // လူဘယ်နှစ်ယောက် ဝင်ကြည့်လဲ မှတ်ရန်
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model PostImage {
  id       String @id @default(cuid())
  imageUrl String @db.VarChar(255)
  publicId String @db.VarChar(255)
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Product {
  id          String             @id @default(cuid())
  name        String             @db.VarChar(255)
  description String
  price       Decimal            @db.Decimal(10, 2)
  discount    Decimal            @default(0) @db.Decimal(10, 2)
  rating      Int                @default(0) @db.SmallInt
  inventory   Int                @default(0)
  status      Status             @default(ACTIVE)
  categoryId  String
  typeId      String
  category    Category           @relation(fields: [categoryId], references: [id])
  type        Type               @relation(fields: [typeId], references: [id])
  orders      ProductsOnOrders[]
  images      ProductImage[]
  users       User[]
  tags        ProductTag[]
  viewCount   Int @default(0) // လူဘယ်နှစ်ယောက် ဝင်ကြည့်လဲ မှတ်ရန်
  searchCount Int @default(0) // Search result ကနေ ဘယ်နှစ်ခါ နှိပ်ခံရလဲ မှတ်ရန်
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  imageUrl  String  @db.VarChar(255)
  publicId  String  @db.VarChar(255)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model SearchTrend {
  id        String   @id @default(cuid())
  keyword   String   @unique @db.VarChar(100)
  count     Int      @default(1) // ဘယ်နှစ်ခါ ရှာခံရလဲ
  updatedAt DateTime @updatedAt
}

model User {
  id                 String     @id @default(cuid())
  firstName          String?    @db.VarChar(52)
  lastName           String?    @db.VarChar(52)
  phone              String     @unique @db.VarChar(15)
  password           String
  email              String?    @unique @db.VarChar(52)
  role               Role       @default(USER)
  status             Status     @default(ACTIVE)
  lastLogin          DateTime?
  errorLoginCount    Int        @default(0) @db.SmallInt
  randomToken        String
  image              UserImage?
  posts              Post[]
  orders             Order[]
  products           Product[]
  lastChangePassword DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // @@map("users") // set this table name
}

model UserImage {
  id       String @id @default(cuid())
  imageUrl String @db.VarChar(255)
  publicId String @db.VarChar(255)
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PostTag {
  id    String @id @default(cuid())
  name  String @unique @db.VarChar(52)
  posts Post[] // Implicit Many-to-Many
}

model ProductTag {
  id       String    @id @default(cuid())
  name     String    @unique @db.VarChar(52)
  products Product[]
}

