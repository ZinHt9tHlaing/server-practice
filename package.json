  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "npx tsc -w",
    "dev": "npx nodemon",
    "build": "tsc",
    "lint": "npx eslint .",
    "db:push": "npx prisma db push",
    "db:pull": "npx prisma db pull",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:migrate": "npx prisma migrate dev",
    "db:reset": "npx prisma migrate reset",
    "db:seed": "ts-node prisma/seed.ts",
    "gen-secret": "openssl rand -base64 32",
    "image:work": "nodemon --exec ts-node -r tsconfig-paths/register src/jobs/workers/imageWorker.ts",
    "cache:work": "nodemon --exec ts-node -r tsconfig-paths/register src/jobs/workers/cacheWorker.ts",
    "work:all": "concurrently \"npm run image:work\" \"npm run cache:work\""
  },
